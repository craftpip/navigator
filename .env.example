# Environment Configuration Template
# ================================
# Copy this file to .env and adjust values as needed.
# The defaults in docker-compose.yml cover everything else —
# a fresh `docker compose up -d` works with no .env at all.
#
# For the full reference of every supported variable, see .env.example.full

HEADLESS=true               # Run browser without UI (true/false)
ENABLE_HTTP_MCP=1           # Enable Streamable HTTP transport at /mcp
MCP_API_PORT=1994            # Port for HTTP API (serves /console, /health, /mcp, /download)
BROWSERS=[{"name":"chromium","role":[]},{"name":"cloakbrowser","role":["default","search","fetch","screenshot","devtools"],"cdpUrl":"http://cloak-browser:9222"}]  # Browser array: {"name","role":["default"|"search"|"fetch"|"screenshot"|"devtools"],"cdpUrl":"ws://host:9222" or "http://host:9222" for CDP-server add-ons like cloakbrowser}. Empty role = fallback/backup only (chromium when all add-ons are down).
CLOAKBROWSER_LICENSE_KEY=    # License key for the cloak-browser CDP sidecar (optional for testing)
DISABLE_TOOLS=               # MCP tools to disable, comma-separated. Empty = all enabled. e.g. web_page_ascii,DOM.getCompactHTML
ENABLE_WEB_CONSOLE=1         # Serve the live management console at /console (same port as MCP)
ENABLE_VNC=1                 # Start the Xvfb display stack at boot (noVNC at :NOVNC_PORT)
NOVNC_PORT=1996              # Published noVNC web port (http://localhost:1996/vnc.html)
EXA_API_KEY=                 # Exa search API key (https://dashboard.exa.ai/api-keys) — when set, enables the exa_api search route
LINKUP_API_KEY=              # Linkup search API key (https://app.linkup.so/api-keys) — when set, enables the linkup_api search route
TAVILY_API_KEY=               # Tavily search API key (https://app.tavily.com/) — when set, enables the tavily_api search route
FIRECRAWL_API_KEY=            # Firecrawl search API key (https://www.firecrawl.dev/app/api-keys) — when set, enables the firecrawl_api search route

# --- MinerU-HTML GPU sidecar (navigator-mineru container) ---------------------
# An optional "AI Model" extractor for web_fetch. The knob you most likely want
# on a bigger GPU is MINERU_CONTEXT_WINDOW — KV cache is ~96 KiB/token:
# 13312 ~= 1.2 GiB (GTX 1650 4GB default) / 32768 ~= 3.0 GiB / 65536 ~= 6.0 GiB.
# MINERU_GPU=all                  # GPU(s) to expose: all, a UUID, or an index
# MINERU_PORT=1998                # Published port (match POST_PROCESSOR_MODELS baseUrl)
# MINERU_BACKEND=vllm             # "vllm" (default) or "transformers"
# MINERU_CONTEXT_WINDOW=13312     # Classification prompt window in tokens
# MINERU_GPU_MEM_UTIL=0.95        # VRAM fraction given to vLLM
# MINERU_MAX_INPUT_CHARS=400000   # HTML tail-cut length before extraction
# MINERU_TENSOR_PARALLEL_SIZE=1   # Multi-GPU tensor parallelism (1 = single GPU)
# MINERU_DTYPE=                   # Model dtype; "" = auto. bfloat16 on CC >= 8.0
# MINERU_ENFORCE_EAGER=true       # false on CC >= 8.0 for CUDA-graph speedups
# MINERU_USE_FALLBACK=trafilatura # Fallback: trafilatura | bypass | empty
# MINERU_OUTPUT_FORMAT=plain_md   # plain_md | mm_md | md | json | txt
# MINERU_VLLM_ATTENTION_BACKEND=TRITON_ATTN  # FLASH_ATTN on CC >= 8.0
# MINERU_PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
