[
  {
    "domain": "*",
    "pathPattern": "/**",
    "pageType": "default",
    "comment": "Default extraction for all URLs. Edit in the Domain hints panel.",
    "default": {
      "format": "trafilatura_to_markdown",
      "stabilizeStrategy": "network_idle",
      "waitForSelector": [],
      "waitForContent": [],
      "skipSelectors": []
    }
