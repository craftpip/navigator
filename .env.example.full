# Environment Configuration Template
# ================================
# Copy this file to .env and adjust values as needed.
# These defaults are mirrored in docker-compose.yml environment section.

# ============================================================================
# Browser Array - Configure all browser backends
# ============================================================================
# BROWSERS=[{"name":"chromium","role":["default"]}]
#   Each entry: {"name":"chromium","role":["default"|"search"|"fetch"|"screenshot"|"devtools"]}
#   Add-on (external CDP): {"name":"playwright","role":["devtools"],"cdpUrl":"ws://playwright:9222"}
#   - name: unique browser id (builtin: chromium; add-ons: any name + cdpUrl)
#   - role: array — "default" (everything), "search", "fetch", "screenshot", "devtools".
#     Empty role array ([]) = fallback/backup only. Missing role defaults to ["default"].
#   - cdpUrl: presence makes this an add-on (external CDP).
#     ws://wss:// ... direct browser WebSocket endpoint -> puppeteer.connect({ browserWSEndpoint })
#     http://https:// . CDP server (cloakserve, --remote-debugging-port) -> puppeteer.connect({ browserURL })
#   There is no `connect` driver field — the cdpUrl scheme picks the connect path.
#   Chromium is always present even if omitted.

# ============================================================================
# Browser Launch - Controls how Chromium starts
# ============================================================================
HEADLESS=true               # Run browser without UI (true/false)
CHROME_PATH=/usr/bin/chromium
CHROME_USER_DATA_DIR=/data/chrome    # Persistent Chrome profile directory
CHROME_PROFILE_DIR=Default           # Chrome profile folder name
PRELAUNCH_BROWSER=1                 # Pre-launch browser on server start
STARTUP_URL=about:blank             # URL to open on startup

# ============================================================================
# Browser Operation - Runtime behavior
# ============================================================================
BROWSER_OP_TIMEOUT_MS=25000     # Timeout for browser operations (ms)
NAV_WAIT_UNTIL=domcontentloaded  # Navigation wait strategy: load, domcontentloaded, networkidle0, networkidle2
HUMAN_TYPING_DELAY=0             # Delay per character (ms); set 0 for high-load throughput
ENABLE_HANG_RESTART=0            # Exit process on hung top-level browser ops so Docker can restart
HANG_RESTART_TIMEOUT_MS=120000   # Hang threshold for forced restart (ms)

# ============================================================================
# Search Engine Selection
# ============================================================================
# EXA_API_KEY=                         # Exa search API key (https://dashboard.exa.ai/api-keys) — when set, enables the exa_api search route
# LINKUP_API_KEY=                      # Linkup search API key (https://app.linkup.so/api-keys) — when set, enables the linkup_api search route
# TAVILY_API_KEY=                      # Tavily search API key (https://app.tavily.com/) — when set, enables the tavily_api search route
# FIRECRAWL_API_KEY=                   # Firecrawl search API key (https://www.firecrawl.dev/app/api-keys) — when set, enables the firecrawl_api search route
# SEARCH_ENABLED_ENGINES=              # Search routes for select_best (comma-separated). Leave empty for the built-in default. Add exa_api, linkup_api, tavily_api or firecrawl_api to the list to use them (requires API key).
# SEARCH_ROUTE_WARMUP_ENGINES=duckduckgo_api,google,bing,duckduckgo  # Search routes to prewarm (comma-separated)

# ============================================================================
# Search Engine Windows - Concurrent window management per engine
# ============================================================================
SEARCH_ROUTE_CIRCUIT_OPEN_MS=300000  # Route cooldown after failure (ms)
SEARCH_KEEP_MIN_WORKING_WINDOWS=2      # Min warm windows to keep open per engine
SEARCH_MAX_WORKING_WINDOWS=4           # Max concurrent windows per engine
OPEN_PAGE_MAX_PARALLEL=4              # Max parallel open_page operations
MAX_CONCURRENT_PAGE_OPS=30            # Global max concurrent page operations

# ============================================================================
# VNC and noVNC - Remote browser viewing
# ============================================================================
ENABLE_VNC=1              # Enable VNC server (1=yes, 0=no)
VNC_PORT=1995             # VNC port
NOVNC_PORT=1996           # noVNC web interface port

# ============================================================================
# HTTP API Server - REST endpoints (shares MCP_API_PORT)
# ============================================================================
ENABLE_HTTP_HEALTH=1             # Enable HTTP health endpoint at /health
ENABLE_WEB_CONSOLE=1             # Serve the live management console at /console (same port as MCP)
MCP_API_PORT=1994                 # Port for HTTP API (serves /console, /health, /mcp if HTTP_MCP enabled, /download)
MCP_API_HOST=http://localhost     # Host binding for API server

# ============================================================================
# MCP Transports - How MCP server communicates
# ============================================================================
ENABLE_STDIO_MCP=1          # Enable stdio transport for clients that launch a local MCP process
ENABLE_HTTP_MCP=1           # Enable Streamable HTTP transport at /mcp (recommended default)
ENABLE_DEVTOOLS_MCP=1       # Enable extra browser-testing tools (tabs, DOM, console, click, type)
# Devtools browser is now selected via BROWSERS role "devtools" (falls back to "default")

# ============================================================================
# Screenshots - Download and storage options
# ============================================================================
ENABLE_SCREENSHOT_DOWNLOAD_LINK=0  # Enable screenshot download at /download/{id}
ENABLE_SCREENSHOT_PATH=            # Custom screenshot storage path (leave empty for default)

# ============================================================================
# MinerU-HTML GPU Sidecar (navigator-mineru container)
# An optional "AI Model" extractor for web_fetch serving POST /extract on :1998.
# Every knob below is read from the container environment; defaults match the
# docker-compose.yml service block. KV cache is ~96 KiB/token, so on a bigger
# GPU raise MINERU_CONTEXT_WINDOW (13312 ~= 1.2 GiB / 32768 ~= 3.0 GiB /
# 65536 ~= 6.0 GiB) and, on CC >= 8.0 cards, set MINERU_DTYPE=bfloat16,
# MINERU_ENFORCE_EAGER=false, and VLLM_ATTENTION_BACKEND=FLASH_ATTN.
# ============================================================================
# MINERU_GPU=all                      # GPU(s) to expose: all, a UUID, or an index
# MINERU_PORT=1998                    # Published port (match POST_PROCESSOR_MODELS baseUrl)
# MINERU_MEM_LIMIT=8g                 # Container memory limit
# MINERU_BACKEND=vllm                 # "vllm" (default) or "transformers" (vLLM auto-falls back on init failure)
# MINERU_MODEL_PATH=/app/model        # Model weights path inside the image
# MINERU_CONTEXT_WINDOW=13312         # Classification prompt window in tokens (see sizing above)
# MINERU_GPU_MEM_UTIL=0.95            # VRAM fraction given to vLLM (KV cache + activations)
# MINERU_MAX_INPUT_CHARS=400000       # Incoming HTML tail-cut length before extraction
# MINERU_TENSOR_PARALLEL_SIZE=1       # Multi-GPU tensor parallelism (1 = single GPU)
# MINERU_ENFORCE_EAGER=true           # true = no CUDA graphs (lower VRAM); false on CC >= 8.0
# MINERU_DTYPE=                       # Model dtype; "" = auto. bfloat16 needs CC >= 8.0
# MINERU_MAX_TOKENS=16384             # Max completion tokens
# MINERU_TOP_K=1                      # Top-K sampling (near-greedy default)
# MINERU_TOP_P=0.95                   # Top-P sampling
# MINERU_TEMPERATURE=0                # Sampling temperature
# MINERU_GATE_CONCURRENCY=0           # Concurrent /extract requests; 0 = auto (2 vllm / 1 transformers)
# MINERU_USE_FALLBACK=trafilatura     # Fallback when LLM fails or window overflows: trafilatura | bypass | empty
# MINERU_OUTPUT_FORMAT=plain_md       # plain_md | mm_md | md | json | txt
# MINERU_VLLM_ATTENTION_BACKEND=TRITON_ATTN  # TRITON_ATTN (CC 7.5); FLASH_ATTN faster on CC >= 8.0
# MINERU_PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True  # Allocator for fragmented-VRAM GPUs
