        "action": "extract",
        "label": "Comments",
        "content": {
          "blocks": [
            {
              "selector": "#comment-list",
              "label": "Comment List",
              "priority": "high",
              "format": "list"
            }
          ]
        }
      }
    ],
    "flowOptions": {
      "continueOnEmptyExtract": true,
      "totalTimeoutMs": 40000
    }
  },
